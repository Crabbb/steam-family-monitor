# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.test

# local databases and export artifacts
*.db
*.db-*
*.tar
*.tar.gz
*.bak.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local deploy overrides (host paths, personal infrastructure)
compose.override.yml
compose.override.yaml
docker-compose.override.yml

# Non-service material. The repository carries the service and nothing else:
# promotion and channel drafts, articles, personal notes stay local.
docs/channel/
