# Copy to .env and adjust. Never commit the real .env.
#
# Steam API key, Telegram bot token and chat id are NOT set here —
# they are configured at runtime on the Settings page and stored in SQLite.

# Path to the SQLite database file used by Prisma.
# Local dev:
DATABASE_URL="file:./prisma/data/dev.db"
# Inside the Docker image this is set to file:/app/prisma/data/dev.db

# Timezone used by the container and by cron schedules.
TZ="Europe/Moscow"
